# -------------------------------------------------
# Enable clean URLs (hide index.html and .html)
# -------------------------------------------------
RewriteEngine On

# -------------------------------------------------
# Redirect index.html → /
# -------------------------------------------------
RewriteCond %{THE_REQUEST} \s/index\.html [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# -------------------------------------------------
# Redirect .html requests to clean URLs (ex: /about.html → /about)
# -------------------------------------------------
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html [NC]
RewriteRule ^([^.]+)\.html$ /$1 [R=301,L]

# -------------------------------------------------
# Redirect trailing slash on non-root pages (ex: /works/ → /works)
# -------------------------------------------------
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ /$1 [R=301,L]

# -------------------------------------------------
# Internally serve .html files for clean URLs
# Skip existing files, directories, and static assets
# -------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot|webp)$ [NC]
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)/?$ $1.html [L]


